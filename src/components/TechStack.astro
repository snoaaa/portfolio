---
const isFr = Astro.url.pathname.startsWith('/fr');

const stack = [
  // Backend
  { name: 'Java', icon: 'java', category: 'Backend', expMonths: 36 },
  { name: 'Python', icon: 'python', category: 'Backend', expMonths: 36 },
  { name: 'C', icon: 'c', category: 'Backend', expMonths: 24 },
  { name: 'Go', icon: 'go', category: 'Backend', expMonths: 12 },
  { name: 'Ruby', icon: 'ruby', category: 'Backend', expMonths: 12 },
  { name: 'Spring Boot', icon: 'spring-boot', category: 'Backend', expMonths: 24 },
  { name: 'Django', icon: 'django', category: 'Backend', expMonths: 18 },
  { name: 'Node.js', icon: 'nodejs', category: 'Backend', expMonths: 24 },
  { name: 'Express.js', icon: 'express', category: 'Backend', expMonths: 24 },
  { name: 'FastAPI', icon: 'fastapi', category: 'Backend', expMonths: 12 },
  { name: 'Flask', icon: 'flask', category: 'Backend', expMonths: 18 },

  // Database
  { name: 'PostgreSQL', icon: 'postgresql', category: 'Database', expMonths: 24 },
  { name: 'MySQL', icon: 'mysql', category: 'Database', expMonths: 24 },
  { name: 'MongoDB', icon: 'mongodb', category: 'Database', expMonths: 18 },
  { name: 'Redis', icon: 'redis', category: 'Database', expMonths: 12 },
  { name: 'Kafka', icon: 'kafka', category: 'Database', expMonths: 12 },
  { name: 'Elasticsearch', icon: 'elasticsearch', category: 'Database', expMonths: 12 },
  { name: 'Qdrant (Vector)', icon: 'qdrant', category: 'Database', expMonths: 12 },

  // Cloud & DevOps
  { name: 'Linux', icon: 'linux', category: 'Cloud & DevOps', expMonths: 36 },
  { name: 'Docker', icon: 'docker', category: 'Cloud & DevOps', expMonths: 18 },
  { name: 'Kubernetes', icon: 'kubernetes', category: 'Cloud & DevOps', expMonths: 12 },
  { name: 'Terraform', icon: 'terraform', category: 'Cloud & DevOps', expMonths: 12 },
  { name: 'AWS', icon: 'aws', category: 'Cloud & DevOps', expMonths: 18 },
  { name: 'GCP', icon: 'gcp', category: 'Cloud & DevOps', expMonths: 12 },
  { name: 'GitHub Actions', icon: 'githubactions', category: 'Cloud & DevOps', expMonths: 12 },

  // Frontend
  { name: 'TypeScript', icon: 'typescript', category: 'Frontend', expMonths: 24 },
  { name: 'JavaScript', icon: 'javascript', category: 'Frontend', expMonths: 36 },
  { name: 'HTML5', icon: 'html5', category: 'Frontend', expMonths: 36 },
  { name: 'CSS3', icon: 'css3', category: 'Frontend', expMonths: 36 },
  { name: 'React', icon: 'react', category: 'Frontend', expMonths: 24 },
  { name: 'Next.js', icon: 'nextjs', category: 'Frontend', expMonths: 18 },
  { name: 'Angular', icon: 'angular', category: 'Frontend', expMonths: 12 },
  { name: 'Astro', icon: 'astro', category: 'Frontend', expMonths: 12 },
  { name: 'Tailwind CSS', icon: 'tailwindcss', category: 'Frontend', expMonths: 24 },
  { name: 'Bootstrap', icon: 'bootstrap', category: 'Frontend', expMonths: 18 },

  // Mobile
  { name: 'React Native', icon: 'react', category: 'Mobile', expMonths: 18 },
  { name: 'Flutter', icon: 'flutter', category: 'Mobile', expMonths: 12 },

  // Tools
  { name: 'Git', icon: 'git', category: 'Tools', expMonths: 36 },
  { name: 'Postman', icon: 'postman', category: 'Tools', expMonths: 24 },
  { name: 'Prometheus', icon: 'prometheus', category: 'Tools', expMonths: 12 },
  { name: 'Grafana', icon: 'grafana', category: 'Tools', expMonths: 12 },
  { name: 'Figma', icon: 'figma', category: 'Tools', expMonths: 18 },
];

const BASE_YEAR = 2026;
const currentYear = new Date().getFullYear();
const additionalMonths = Math.max(0, (currentYear - BASE_YEAR) * 12);

stack.forEach(tech => {
  tech.expMonths += additionalMonths;
});

const formatExp = (months) => {
  const y = Math.max(1, Math.round(months / 12));
  if (isFr) {
    return `${y} an${y > 1 ? 's' : ''}`;
  }
  return `${y} yr${y > 1 ? 's' : ''}`;
};

stack.sort((a, b) => b.expMonths - a.expMonths);

const categoryOrder = ['Backend', 'Database', 'Cloud & DevOps', 'Frontend', 'Mobile', 'Tools'];
const categoryI18n = {
  'Backend': 'Backend',
  'Database': isFr ? 'Base de données' : 'Database',
  'Cloud & DevOps': 'Cloud & DevOps',
  'Frontend': 'Frontend',
  'Mobile': 'Mobile',
  'Tools': isFr ? 'Outils' : 'Tools'
};

const categories = [...new Set(stack.map((s) => s.category))].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

<style>
  .p-about-skills {
    width: 100%;
    margin-bottom: 96px;
  }
  @media(min-width: 1024px) {
    .p-about-skills { margin-bottom: 160px; }
  }
  .p-about-skills__wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  @media(min-width: 1024px) {
    .p-about-skills__wrapper {
      grid-template-columns: repeat(12, 1fr);
    }
  }
  .p-about-skills__content {
    grid-column: 1/5;
  }
  @media(min-width: 1024px) {
    .p-about-skills__content {
      padding-left: 32px;
      grid-column: 5/13;
    }
  }
  .p-about-skills__title {
    font-family: ''RufinaALT02-Regular'', serif;
    margin-bottom: 40px;
  }
  @media(min-width: 1024px) {
    .p-about-skills__title {
      margin-bottom: 72px;
    }
  }

  /* Accordion styles */
  .skill-accordion {
    border-bottom: 1px solid rgba(35, 53, 128, 0.2);
  }
  .skill-accordion__summary {
    list-style: none; /* Hide default arrow */
    padding: 16px 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
    color: rgba(35, 53, 128, 0.8);
    transition: color 0.3s ease;
  }
  .skill-accordion__summary::-webkit-details-marker {
    display: none;
  }
  .skill-accordion__summary:hover {
    color: rgba(35, 53, 128, 1);
  }
  .skill-accordion__arrow {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    opacity: 0.6;
  }
  .skill-accordion[open] .skill-accordion__arrow {
    transform: rotate(180deg);
  }
  .skill-accordion__content {
    padding: 16px 0 32px 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    justify-items: center;
    row-gap: 32px;
    column-gap: 16px;
    animation: fadeIn 0.3s ease;
  }
  @media(min-width: 768px) {
    .skill-accordion__content {
      column-gap: 48px;
    }
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<section class="p-about-skills">
  <div class="p-about-skills__wrapper l-wrapper">
    <div class="p-about-skills__content">
      <h2 class="text-3xl p-about-skills__title">{isFr ? 'Compétences' : 'Skills'}</h2>
      
      <div class="skills-list">
        {categories.map((category) => (
          <details class="skill-accordion js-skill-accordion" name="skills">
            <summary class="skill-accordion__summary text-lg">
              {categoryI18n[category] || category}
              <svg class="skill-accordion__arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="skill-accordion__content">
              {stack
                .filter((s) => s.category === category)
                .map((tech) => (
                  <div style="display: flex; flex-direction: column; align-items: center; width: 64px; text-align: center; gap: 8px;">
                    <div style="height: 40px; display: flex; align-items: center; justify-content: center;">
                      {tech.icon ? (
                        <img 
                          src={`/images/stacks/${tech.icon}.svg`} 
                          alt={`${tech.name} logo`} 
                          loading="eager"
                          decoding="async"
                          fetchpriority="high"
                          style="width: 32px; height: 32px; object-fit: contain;"
                        />
                      ) : (
                        <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(35, 53, 128, 0.1); border-radius: 8px; font-weight: bold; font-size: 16px; color: rgba(35, 53, 128, 0.8);">
                          {tech.name.charAt(0)}
                        </div>
                      )}
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 2px;">
                      <span style="font-size: 13px; font-weight: 500; line-height: 1.2;">{tech.name}</span>
                      <div style="display: flex; align-items: center; justify-content: center; gap: 4px; opacity: 0.6;">
                        <img src="/images/stacks/clock.svg" alt="" style="width: 12px; height: 12px;" />
                        <span style="font-size: 11px;">{formatExp(tech.expMonths)}</span>
                      </div>
                    </div>
                  </div>
                ))}
            </div>
          </details>
        ))}
      </div>
      
    </div>
  </div>
</section>

<script>
  // Desktop hover functionality 
  const accordions = document.querySelectorAll('.js-skill-accordion');
  
  accordions.forEach(acc => {
    acc.addEventListener('mouseenter', () => {
      if (window.innerWidth >= 1024) {
        acc.setAttribute('open', '');
      }
    });
    
    acc.addEventListener('mouseleave', () => {
      if (window.innerWidth >= 1024) {
        acc.removeAttribute('open');
      }
    });
  });
</script>
