---
const currentPath = Astro.url.pathname;
const isFr = currentPath.startsWith('/fr');

const getNavLink = (path) => {
  if (path === '/') return isFr ? '/fr' : '/';
  return isFr ? `/fr${path}` : path;
};
---

<footer class="footer">
  <div class="l-wrapper footer__wrapper">
    <div class="footer__head">
      <div class="footer__head-wrapper">
        <div class="footer__menu">
          <p class="footer__head-label text-sm">[Menu]</p>
          <ul class="footer__menu-list">
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/')}>{isFr ? 'Accueil' : 'Top'}</a>
            </li>
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/about')}>{isFr ? 'À propos' : 'About'}</a>
            </li>
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/service')}>Service</a>
            </li>
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/work')}>{isFr ? 'Projets' : 'Work'}</a>
            </li>
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/reading-list')}>{isFr ? 'Lectures' : 'Reading List'}</a>
            </li>
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/contact')}>Contact</a>
            </li>
            <li class="footer__list-item">
              <a class="text-sm footer__list-link" href={getNavLink('/chess')}>{isFr ? 'Échecs' : 'Chess'}</a>
            </li>
          </ul>
        </div>
        <div class="footer__social">
          <p class="footer__head-label text-sm">[{isFr ? 'Réseaux sociaux' : 'Social'}]</p>
          <ul class="footer__social-list">
            <li class="footer__social-item">
              <a
                class="text-sm footer__social-link"
                href="https://www.linkedin.com/in/abrahamnoumsi"
                target="_blank"
                rel="noopener noreferrer">LinkedIn</a
              >
            </li>
            <li class="footer__social-item">
              <a
                class="text-sm footer__social-link"
                href="https://github.com/snoaaa"
                target="_blank"
                rel="noopener noreferrer">GitHub</a
              >
            </li>
          </ul>
        </div>
        <div class="footer__mail">
          <p class="footer__head-label text-sm">[Mail]</p>
          <p>
            <a class="text-sm" href="mailto:ab.noumsi@gmail.com"
              >ab.noumsi@gmail.com</a
            >
          </p>
        </div>
      </div>
      <div class="footer__credit">
        <p class="footer__head-label text-sm">[{isFr ? 'Crédits' : 'Credit'}]</p>
        <p class="text-sm">
          {isFr ? 'Design & Développement par' : 'Design & Development by'}
          <span class="footer__credit-name"> Abraham</span>
        </p>
      </div>
    </div>
    <div class="footer__bottom">
      <h2 class="footer__title">
        <span class="text-wrapper"> {isFr ? 'Merci' : 'Thank you'} </span>
      </h2>
    </div>
  </div>
</footer>
