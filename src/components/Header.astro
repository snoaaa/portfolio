---
const currentPath = Astro.url.pathname;
const isFr = currentPath.startsWith('/fr');

const getLangLink = (lang) => {
  if (lang === 'fr') {
    return isFr ? currentPath : `/fr${currentPath === '/' ? '' : currentPath}`;
  } else {
    return isFr ? currentPath.replace(/^\/fr/, '') || '/' : currentPath;
  }
};

const getNavLink = (path) => {
  if (path === '/') return isFr ? '/fr' : '/';
  return isFr ? `/fr${path}` : path;
};
---

<header class="header">
  <div class="header__logo">
    <p class="header__logo-text ink-anim">ABRAHAM NOUMSI</p>
    <span class="header__logo-label ink-anim">{isFr ? "INGÉNIERIE LOGICIELLE / SYSTÈMES D'INFORMATION" : "SOFTWARE ENGINEERING / INFORMATION SYSTEMS"}</span>
  </div>
  <button class="header__hamburger" aria-label="Menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav class="header__nav">
    <ul class="header__list">
      <li class="header__list-item">
        <a class="text-base header__list-link" href={getNavLink('/')}>
          <span class="header__list-hover">[</span>
          <span class="ink-anim">{isFr ? 'Accueil' : 'Top'}</span>
          <span class="header__list-hover">]</span>
        </a>
      </li>
      <li class="header__list-item">
        <a class="text-base header__list-link" href={getNavLink('/about')}>
          <span class="header__list-hover">[</span>
          <span class="ink-anim">{isFr ? 'À propos' : 'About'}</span>
          <span class="header__list-hover">]</span>
        </a>
      </li>
      <li class="header__list-item">
        <a class="text-base header__list-link" href={getNavLink('/service')}>
          <span class="header__list-hover">[</span>
          <span class="ink-anim">Service</span>
          <span class="header__list-hover">]</span>
        </a>
      </li>
      <li class="header__list-item">
        <a class="text-base header__list-link" href={getNavLink('/work')}>
          <span class="header__list-hover">[</span>
          <span class="ink-anim">{isFr ? 'Projets' : 'Work'}</span>
          <span class="header__list-hover">]</span>
        </a>
      </li>
      <li class="header__list-item">
        <a class="text-base header__list-link" href={getNavLink('/reading-list')}>
          <span class="header__list-hover">[</span>
          <span class="ink-anim">{isFr ? 'Lectures' : 'Reading List'}</span>
          <span class="header__list-hover">]</span>
        </a>
      </li>
      <li class="header__list-item">
        <a class="text-base header__list-link" href={getNavLink('/contact')}>
          <span class="header__list-hover">[</span>
          <span class="ink-anim">Contact</span>
          <span class="header__list-hover">]</span>
        </a>
      </li>
      <li class="header__list-item" style="margin-left: 24px; display: flex; align-items: center; gap: 8px;">
        <a class="text-sm ink-anim" style={`transition: opacity 0.3s; ${isFr ? 'opacity: 0.5;' : 'opacity: 1; font-weight: bold;'}`} href={getLangLink('en')}>EN</a>
        <span class="text-sm ink-anim" style="opacity: 0.3;">|</span>
        <a class="text-sm ink-anim" style={`transition: opacity 0.3s; ${!isFr ? 'opacity: 0.5;' : 'opacity: 1; font-weight: bold;'}`} href={getLangLink('fr')}>FR</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const hamburger = document.querySelector('.header__hamburger');
    const nav = document.querySelector('.header__nav');
    const body = document.querySelector('body');

    if (hamburger && nav) {
      hamburger.addEventListener('click', () => {
        const isActive = nav.classList.toggle('is-active');
        hamburger.classList.toggle('is-active');
        hamburger.setAttribute('aria-expanded', isActive ? 'true' : 'false');
        if (isActive) {
          body.style.overflow = 'hidden';
        } else {
          body.style.overflow = '';
        }
      });

      // Close menu when a link is clicked
      const links = nav.querySelectorAll('.header__list-link');
      links.forEach(link => {
        link.addEventListener('click', () => {
          nav.classList.remove('is-active');
          hamburger.classList.remove('is-active');
          hamburger.setAttribute('aria-expanded', 'false');
          body.style.overflow = '';
        });
      });

      // Prevent body overflow lock if screen is resized to desktop while open
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024 && nav.classList.contains('is-active')) {
          nav.classList.remove('is-active');
          hamburger.classList.remove('is-active');
          hamburger.setAttribute('aria-expanded', 'false');
          body.style.overflow = '';
        }
      });
    }
  });
</script>
