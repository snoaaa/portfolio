---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 Page Non Trouvée | Abraham Noumsi"
  pathname="/fr/404/"
  showHeaderFooter={false}
>
  <style
    slot="head"
    set:html={`.p-error-fv{width:100%;height:100svh}.p-error-fv__wrapper{width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center}.p-error-fv__body{display:flex;flex-direction:column}.p-error-fv__body-text{margin-bottom:48px}.p-error-fv__body-link{width:fit-content;display:flex;margin:0 auto;gap:4px}@media(min-width:1024px){.p-error-fv__body-link:hover .p-error-fv__body-bracket{opacity:1}}.p-error-fv__body-bracket{opacity:0;transition:opacity .3s ease-in-out}.p-error-fv__title{font-size:clamp(7.5rem,4.8592rem + 11.2676vw,15rem);letter-spacing:-.07em;line-height:1;font-weight:500}`}
  ></style>
  <main class="main">
    <section class="p-error-fv">
      <div class="p-error-fv__wrapper l-wrapper">
        <h1 class="p-error-fv__title ink-anim">404</h1>
        <div class="p-error-fv__body">
          <p class="text-base p-error-fv__body-text ink-anim">
            Désolé :) Nous n'avons pas pu trouver cette page.
          </p>
          <a href="/fr" class="text-base p-error-fv__body-link ink-anim">
            <span class="p-error-fv__body-bracket">[</span>
            Retour à l'accueil
            <span class="p-error-fv__body-bracket">]</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
