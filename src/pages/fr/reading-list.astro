---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Books Data Structure
const currentlyReading = {
  title: "The Body Keeps the Score: Brain, Mind, and Body in the Healing of Trauma",
  author: "Bessel van der Kolk",
  publisher: "Viking",
  year: 2014,
  edition: "1ère Édition",
  genre: "Psychologie / Santé",
  description: "Un regard inspirant et exhaustif sur les effets des traumatismes et sur les nouveaux traitements qui peuvent aider les individus à reprendre le contrôle de leur vie. Ce livre change fondamentalement notre façon de comprendre la réponse humaine au stress."
};

const pastReads = [
  {
    title: "Things Fall Apart",
    author: "Chinua Achebe",
    publisher: "William Heinemann Ltd",
    year: 1958,
    edition: "1ère Édition",
    genre: "Fiction Africaine",
    quote: "Quand la souffrance frappe à ta porte et que tu lui dis qu'il n'y a pas de siège pour elle, elle te dit de ne pas t'inquiéter car elle a apporté son propre tabouret."
  },
  {
    title: "The Psychology of Money",
    author: "Morgan Housel",
    publisher: "Harriman House",
    year: 2020,
    edition: "1ère Édition",
    genre: "Finance",
    quote: "Réussir avec l'argent a peu à voir avec votre intelligence et beaucoup à voir avec votre comportement."
  },
  {
    title: "Thinking, Fast and Slow",
    author: "Daniel Kahneman",
    publisher: "Farrar, Straus and Giroux",
    year: 2011,
    edition: "1ère Édition",
    genre: "Psychologie",
    quote: "Rien dans la vie n'est aussi important que vous le pensez, pendant que vous y pensez."
  },
  {
    title: "Shoe Dog",
    author: "Phil Knight",
    publisher: "Simon & Schuster",
    year: 2016,
    edition: "1ère Édition",
    genre: "Biographie / Affaires",
    quote: "Ne dites pas aux gens comment faire les choses, dites-leur quoi faire et laissez-les vous surprendre par leurs résultats."
  },
  {
    title: "Sapiens: A Brief History of Humankind",
    author: "Yuval Noah Harari",
    publisher: "Harvill Secker",
    year: 2011,
    edition: "1ère Édition",
    genre: "Histoire / Anthropologie",
    quote: "L'histoire est quelque chose que très peu de gens ont fait pendant que tout le monde labourait les champs et portait des seaux d'eau."
  },
  {
    title: "Americanah",
    author: "Chimamanda Ngozi Adichie",
    publisher: "Knopf",
    year: 2013,
    edition: "1ère Édition",
    genre: "Fiction Contemporaine",
    quote: "Si vous ne comprenez pas, posez des questions. Si vous êtes mal à l'aise de poser des questions, dites que vous êtes mal à l'aise de poser des questions, puis posez-les quand même."
  },
  {
    title: "The Black Swan",
    author: "Nassim Nicholas Taleb",
    publisher: "Random House",
    year: 2007,
    edition: "2ème Édition",
    genre: "Philosophie",
    quote: "Rater un train n'est douloureux que si vous courez après !"
  }
];
---

<BaseLayout
  title="Liste de Lecture | Abraham Noumsi"
  description="Une collection de livres que je lis actuellement et de mes favoris passés, accompagnés d'extraits intéressants."
  pathname="/fr/reading-list/"
  showHeaderFooter={true}
>
  <style>
    .p-books {
      padding-top: 120px;
      padding-bottom: 64px;
      width: 100%;
    }
    @media (min-width: 1024px) {
      .p-books {
        padding-top: 160px;
        padding-bottom: 96px;
      }
    }
    .p-books__section {
      margin-bottom: 80px;
    }
    .p-books__section-title {
      font-family: 'RufinaALT02-Regular', serif;
      margin-bottom: 40px;
      font-size: clamp(3rem, 1rem + 6vw, 6rem);
      line-height: 1;
    }
    
    /* Metadata Grid */
    .p-books__metadata {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      font-size: 0.875rem;
      opacity: 0.8;
      margin-top: 12px;
      margin-bottom: 16px;
    }
    @media (min-width: 768px) {
      .p-books__metadata {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    .p-books__metadata-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .p-books__metadata-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.6;
    }

    /* Currently Reading */
    .p-books__current {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      border-top: 1px solid rgba(35, 53, 128, 0.2);
      padding-top: 32px;
    }
    @media (min-width: 1024px) {
      .p-books__current {
        grid-template-columns: 1fr 2fr;
        gap: 48px;
      }
    }
    .p-books__current-meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .p-books__current-title {
      font-size: clamp(1.75rem, 1rem + 3vw, 3rem);
      line-height: 1.1;
      font-weight: 500;
      margin-bottom: 8px;
      font-family: 'RufinaALT02-Regular', serif;
    }
    .p-books__current-author {
      font-size: 1.125rem;
      font-weight: 500;
    }
    .p-books__current-desc {
      font-size: clamp(1rem, 0.9rem + 0.3vw, 1.125rem);
      line-height: 1.6;
      max-width: 800px;
    }
    
    /* Past Reads */
    .p-books__past-list {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .p-books__past-item {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      border-top: 1px solid rgba(35, 53, 128, 0.2);
      padding-top: 32px;
      transition: all 0.3s ease;
    }
    .p-books__past-item:hover {
      background: rgba(35, 53, 128, 0.02);
    }
    @media (min-width: 1024px) {
      .p-books__past-item {
        grid-template-columns: 1fr 2fr;
        gap: 48px;
      }
    }
    .p-books__past-quote {
      font-family: 'RufinaALT02-Regular', serif;
      font-size: clamp(1.125rem, 1rem + 1.5vw, 1.75rem);
      line-height: 1.5;
      font-style: italic;
      color: rgba(35, 53, 128, 0.85);
    }
    .p-books__past-quote::before {
      content: '"';
    }
    .p-books__past-quote::after {
      content: '"';
    }
    .p-books__past-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .p-books__past-title {
      font-size: clamp(1.125rem, 1rem + 1vw, 1.5rem);
      font-weight: 500;
      margin-bottom: 4px;
    }
  </style>

  <main class="main">
    <div class="page-header">
      <div class="page-header__wrapper l-wrapper">
        <h1 class="text-6xl page-header__title ink-anim" style="margin-bottom: 24px;">
          Liste de Lecture
        </h1>
        <p class="page-header__label text-lg ink-anim">
          <span style="opacity: 0.5; margin-right: 8px;">></span>
          <span class="js-typewriter" data-strings='["Livres lus", "Ma bibliothèque", "Lectures recommandées"]'>Livres lus</span><span class="typewriter-cursor"></span>
        </p>
        <p class="text-lg ink-anim" style="max-width: 600px; line-height: 1.6; opacity: 0.8; margin-bottom: 48px;">
          Une sélection de livres que j'ai lus et que je lis actuellement, qui ont façonné ma pensée. Vous y trouverez des lectures intéressantes dans divers genres, ainsi que certains de mes passages préférés.
        </p>
        <div class="page-header__border"></div>
      </div>
    </div>

    <div class="p-books l-wrapper" style="padding-top: 64px;">
      <section class="p-books__section">
        <h2 class="p-books__section-title ink-anim">Lecture en cours</h2>
        <div class="p-books__current">
          <div class="p-books__current-meta ink-anim">
            <h2 class="p-books__current-title">{currentlyReading.title}</h2>
            <p class="p-books__current-author">{currentlyReading.author}</p>
            <div class="p-books__metadata">
              <div class="p-books__metadata-item">
                <span class="p-books__metadata-label">Genre</span>
                <span>{currentlyReading.genre}</span>
              </div>
              <div class="p-books__metadata-item">
                <span class="p-books__metadata-label">Éditeur</span>
                <span>{currentlyReading.publisher}</span>
              </div>
              <div class="p-books__metadata-item">
                <span class="p-books__metadata-label">Année</span>
                <span>{currentlyReading.year}</span>
              </div>
              <div class="p-books__metadata-item">
                <span class="p-books__metadata-label">Édition</span>
                <span>{currentlyReading.edition}</span>
              </div>
            </div>
          </div>
          <div class="p-books__current-desc ink-anim">
            <p>{currentlyReading.description}</p>
          </div>
        </div>
      </section>

      <section class="p-books__section">
        <h2 class="p-books__section-title ink-anim">Lectures passées</h2>
        <div class="p-books__past-list">
          {pastReads.map((book) => (
            <div class="p-books__past-item">
              <div class="p-books__past-meta ink-anim">
                <h3 class="p-books__past-title">{book.title}</h3>
                <p class="text-base" style="font-weight: 500;">{book.author}</p>
                <div class="p-books__metadata" style="margin-top: 8px; margin-bottom: 0;">
                  <div class="p-books__metadata-item">
                     <span class="p-books__metadata-label">Genre</span>
                    <span>{book.genre}</span>
                  </div>
                  <div class="p-books__metadata-item">
                    <span class="p-books__metadata-label">Éditeur</span>
                    <span>{book.publisher}</span>
                  </div>
                  <div class="p-books__metadata-item">
                    <span class="p-books__metadata-label">Année</span>
                    <span>{book.year}</span>
                  </div>
                  <div class="p-books__metadata-item">
                    <span class="p-books__metadata-label">Édition</span>
                    <span>{book.edition}</span>
                  </div>
                </div>
              </div>
              <div class="ink-anim" style="display: flex; align-items: center;">
                <p class="p-books__past-quote">{book.quote}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
