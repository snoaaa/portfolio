---
import BaseLayout from "../../layouts/BaseLayout.astro";

const currentPath = Astro.url.pathname;
const isFr = currentPath.startsWith('/fr');

const getLangLink = (lang) => {
  if (lang === 'fr') {
    return isFr ? currentPath : `/fr${currentPath === '/' ? '' : currentPath}`;
  } else {
    return isFr ? currentPath.replace(/^\/fr/, '') || '/' : currentPath;
  }
};

const getNavLink = (path) => {
  if (path === '/') return isFr ? '/fr' : '/';
  return isFr ? `/fr${path}` : path;
};
