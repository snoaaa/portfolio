---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabase } from "../lib/supabase";

const { data: projects, error } = await supabase
  .from('projects')
  .select('*')
  .order('created_at', { ascending: true });

if (error) {
  console.error("Error fetching projects:", error);
}
---

<BaseLayout
  title="Work | Abraham Noumsi"
  pathname="/work/"
  showHeaderFooter={true}
>
  <style
    slot="head"
    set:html={`.p-work-list__item{display:grid;grid-template-columns:1fr;grid-template-rows:repeat(2,auto);row-gap:40px;margin-bottom:96px;position:relative}@media(min-width:1024px){.p-work-list__item{grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(1,auto);row-gap:0px;margin-bottom:160px}}.p-work-list__img{grid-row:1/2;overflow:hidden}@media(min-width:1024px){.p-work-list__img{grid-column:8/13;grid-row:1/2;position:relative;aspect-ratio:576/420}}.p-work-list__img img{width:100%;height:auto;object-fit:cover}@media(min-width:1024px){.p-work-list__img img{height:120%;position:absolute;top:0;left:0}}.p-work-list__info{grid-row:2/3}@media(min-width:1024px){.p-work-list__info{grid-column:1/6;grid-row:1/2;max-width:600px;height:fit-content;position:sticky;top:80px}}.p-work-list__info-detail{display:flex;flex-direction:column;row-gap:24px;margin-bottom:40px}@media(min-width:1024px){.p-work-list__info-detail{flex-direction:row;gap:72px}}.p-work-list__info-title{margin-bottom:16px}@media(min-width:1024px){.p-work-list__info-title{margin-bottom:32px}}.p-work-list__info-desc{margin-bottom:40px}.p-work-list__link{width:fit-content;display:flex;align-items:center;gap:16px}@media(min-width:1024px){.p-work-list__link{gap:24px}.p-work-list__link:hover .p-work-list__link-text{opacity:.5}}.p-work-list__link-circle{width:40px;height:40px;border-radius:50%;border:solid 1px #233580;position:relative}@media(min-width:1024px){.p-work-list__link-circle{width:50px;height:50px}}.p-work-list__link-dot{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:4px;height:4px;border-radius:50%;background-color:#233580}@media(min-width:1024px){.p-work-list__link-dot{width:6px;height:6px}}@media(min-width:1024px){.p-work-list__link-text{opacity:1;transition:opacity .3s ease-in-out}}
`}
  ></style>
  <main class="main">
    <div class="page-header">
      <div class="page-header__wrapper l-wrapper">

        <h1 class="text-6xl page-header__title ink-anim">Work<br /></h1>
        <p class="page-header__label text-lg ink-anim">
          <span style="opacity: 0.5; margin-right: 8px;">></span>
          <span class="js-typewriter" data-strings='["Selected Work", "My projects so far", "Recent builds"]'>Selected Work</span><span class="typewriter-cursor"></span>
        </p>
        <div class="page-header__scroll">
          <span class="text-sm page-header__scroll-text ink-anim js-scroll-text"
            >Scroll</span
          >
          <span
            class="text-sm page-header__scroll-text ink-anim page-header__scroll-text--clone js-scroll-text-clone"
            >Scroll</span
          >
        </div>
        <div class="page-header__border">
          <!-- {
        showCircle && (
          <div class="page-header__border-circle">
            <svg viewBox="0 0 200 200">
              <defs>
                <path
                  id="circlePath"
                  d="M 100,100 m -75,0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0"
                />
              </defs>

              <text>
                <textPath href="#circlePath">Hello World Hello World</textPath>
              </text>
            </svg>
          </div>
        )
      } -->
        </div>
      </div>
    </div>
    <section class="p-work-list">
      <div class="p-work-list__wrapper l-wrapper">
        {projects && projects.map((project) => (
          <article class="p-work-list__item">
            <div class="p-work-list__info">
              <h2 class="p-work-list__info-title text-3xl ink-anim">
                {project.title}
              </h2>
              <p class="p-work-list__info-desc text-base ink-anim">
                {project.description_en}
              </p>
              <div class="p-work-list__info-detail">
                <div class="p-work-list__info-stack">
                  <span class="text-xs ink-anim">Stack</span>
                  <p class="text-base ink-anim">{project.stack}</p>
                </div>
                <div class="p-work-list__info-role">
                  <span class="text-xs ink-anim">Role</span>
                  <p class="text-base ink-anim">{project.role_en}</p>
                </div>
              </div>
              
              {project.link ? (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="p-work-list__link">
                  <div class="p-work-list__link-circle">
                    <div class="p-work-list__link-dot"></div>
                  </div>
                  <p class="text-base p-work-list__link-text">Visit Project</p>
                </a>
              ) : (
                <div class="p-work-list__link" style="opacity: 0.5; cursor: not-allowed;">
                  <div class="p-work-list__link-circle">
                    <div class="p-work-list__link-dot"></div>
                  </div>
                  <p class="text-base p-work-list__link-text">{project.status}</p>
                </div>
              )}
            </div>
            <div class="p-work-list__img">
              <img src={project.image_url} alt={project.title} />
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
