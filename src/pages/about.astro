---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechStack from "../components/TechStack.astro";

const birthDate = new Date("2005-03-03");
const today = new Date();
let age = today.getFullYear() - birthDate.getFullYear();
const m = today.getMonth() - birthDate.getMonth();
if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
  age--;
}
---

<BaseLayout
  title="About | Abraham Noumsi"
  pathname="/about/"
  showHeaderFooter={true}
>
  <style
    slot="head"
    set:html={`.p-about-info{width:100%;margin-bottom:96px}@media(min-width:1024px){.p-about-info{margin-bottom:160px}}.p-about-info__wrapper{display:grid;grid-template-columns:repeat(4,1fr);row-gap:64px;grid-template-rows:repeat(2,auto)}@media(min-width:1024px){.p-about-info__wrapper{row-gap:0px;grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(2,1fr)}}.p-about-info__img{grid-column:1/3;grid-row:1/2;overflow:hidden}@media(min-width:1024px){.p-about-info__img{grid-column:1/5;grid-row:1/3;position:relative;height:100%}}.p-about-info__img img{width:100%;height:auto;object-fit:cover;display:block;position:relative}@media(min-width:1024px){.p-about-info__img img{height:120%;position:absolute;top:0;left:0}}.p-about-info__age{padding-left:16px;grid-column:3/5;grid-row:1/2;display:flex;flex-direction:column;justify-content:space-between}@media(min-width:1024px){.p-about-info__age{padding-left:0;grid-column:7/13}}.p-about-info__age-num{text-align:right;font-size:clamp(6rem,2.7391rem + 13.913vw,25rem);line-height:1;letter-spacing:-.07em;display:flex;justify-content:flex-end}.p-about-info__profile{grid-column:1/5;grid-row:2/3}@media(min-width:1024px){.p-about-info__profile{padding-left:32px;grid-column:5/13;grid-row:1/3;align-self:start;padding-top:24px}}.p-about-info__profile-wrapper{margin-top:0;display:grid;grid-template-columns:repeat(1,1fr);grid-auto-rows:auto;row-gap:48px}@media(min-width:1024px){.p-about-info__profile-wrapper{grid-template-columns:repeat(2,1fr);grid-auto-rows:auto;row-gap:48px;column-gap:64px}}.p-about-info__profile-title{font-family:'RufinaALT02-Regular';margin-bottom:40px}@media(min-width:1024px){.p-about-info__profile-title{margin-bottom:72px}}.p-about-info__profile-item{display:flex;flex-direction:column;gap:16px}@media(min-width:1024px){.p-about-info__profile-item{gap:16px}}.p-about-approach{width:100%;padding:64px 0;color:#fffdf1;margin-bottom:96px;background-image:url(/images/about-bg.DK3abAYJ.jpg);background-size:cover;background-repeat:no-repeat;background-position-x:40%;position:relative;overflow:hidden}@media(min-width:1024px){.p-about-approach{background-image:none;padding:96px 0}}.p-about-approach__bg{display:none;overflow:hidden}.p-about-approach__bg img{width:100%;height:120%;position:absolute;top:0;left:0;object-fit:cover}@media(min-width:1024px){.p-about-approach__bg{display:block}}.p-about-approach__wrapper{position:relative}@media(min-width:1024px){.p-about-approach__wrapper{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(2,auto);row-gap:120px}}.p-about-approach__head{margin-bottom:96px}@media(min-width:1024px){.p-about-approach__head{margin-bottom:0}}@media(min-width:1024px){.p-about-approach__list{grid-column:6/13;grid-row:2/3;max-width:800px}}.p-about-approach__list-item{margin-bottom:48px}@media(min-width:1024px){.p-about-approach__list-item{margin-bottom:80px}}.p-about-approach__list-item:last-child{margin-bottom:0}.p-about-approach__list-title{margin-bottom:16px}.p-about-award__title{font-family:'RufinaALT02-Regular';text-align:center;font-size:clamp(3rem,-.4539rem + 14.7368vw,23.125rem);line-height:1}
`}
  ></style>

  <main class="main">
    <div class="page-header">
      <div class="page-header__wrapper l-wrapper">
        <h1 class="text-6xl page-header__title ink-anim">
          I'm a<br /> Software Engineering<br /> Student<br />
        </h1>
        <p class="page-header__label text-lg ink-anim">
          <span style="opacity: 0.5; margin-right: 8px;">></span>
          <span class="js-typewriter" data-strings='["About me", "My background", "Who I am"]'>About me</span><span class="typewriter-cursor"></span>
        </p>
        <div class="page-header__scroll">
          <span class="text-sm page-header__scroll-text ink-anim js-scroll-text"
            >Scroll</span
          >
          <span
            class="text-sm page-header__scroll-text ink-anim page-header__scroll-text--clone js-scroll-text-clone"
            >Scroll</span
          >
        </div>
        <div class="page-header__border">
          <!-- {
        showCircle && (
          <div class="page-header__border-circle">
            <svg viewBox="0 0 200 200">
              <defs>
                <path
                  id="circlePath"
                  d="M 100,100 m -75,0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0"
                />
              </defs>

              <text>
                <textPath href="#circlePath">Hello World Hello World</textPath>
              </text>
            </svg>
          </div>
        )
      } -->
        </div>
      </div>
    </div>
    <section class="p-about-info">
      <div class="p-about-info__wrapper l-wrapper">
        <div class="p-about-info__img" style="height: auto; align-self: start; mask-image: linear-gradient(to bottom, black 50%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);">
          <svg class="ink-anim" viewBox="0 0 735 727" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: auto; aspect-ratio: 4/5; display: block; mix-blend-mode: plus-lighter;">
            <g transform="translate(0.000000,727.000000) scale(0.100000,-0.100000)" fill="currentColor" opacity="0.15" stroke="none">
              <path d="M2976 6778 c-55 -8 -106 -48 -106 -83 0 -23 -25 -33 -195 -81 -86 -24 -202 -96 -287 -178 -187 -183 -231 -258 -236 -407 -5 -130 6 -166 76 -239 31 -33 73 -77 92 -98 19 -21 44 -44 55 -52 11 -8 37 -34 58 -58 28 -31 36 -48 32 -65 -16 -63 45 -240 158 -457 72 -139 90 -152 209 -149 101 3 117 -5 138 -74 7 -23 23 -64 36 -90 14 -26 22 -52 19 -57 -9 -15 -131 -100 -143 -100 -5 0 -12 7 -16 15 -3 8 -12 12 -20 9 -9 -3 -12 -12 -9 -21 5 -12 3 -14 -7 -8 -9 5 -11 4 -6 -3 4 -7 2 -12 -3 -12 -6 0 -11 4 -11 9 0 5 -11 4 -25 -2 -14 -7 -25 -17 -25 -24 0 -7 -7 -10 -17 -7 -15 5 -16 4 -3 -5 13 -9 13 -11 0 -12 -8 -1 -19 -1 -23 0 -5 1 -6 -3 -2 -9 11 -18 34 -10 50 18 9 15 14 19 11 10 -3 -10 -1 -18 4 -18 6 0 10 8 10 19 0 14 6 17 24 14 18 -4 26 0 31 17 5 16 10 19 18 11 15 -15 8 -20 -98 -76 -157 -84 -254 -156 -341 -254 -128 -143 -146 -197 -138 -401 10 -247 35 -391 114 -645 180 -583 249 -745 317 -745 32 0 55 -36 69 -108 33 -166 65 -372 74 -480 6 -64 13 -125 16 -135 3 -9 -8 -57 -25 -105 -52 -150 -132 -449 -141 -530 -23 -203 -49 -311 -97 -405 -46 -89 -47 -95 -51 -198 -5 -126 -14 -112 142 -213 59 -37 115 -80 124 -94 13 -21 16 -45 14 -114 l-2 -88 1242 0 1243 0 -2 207 c-1 174 2 225 19 311 23 118 17 169 -29 229 -25 32 -25 37 -15 86 23 102 34 252 27 360 -6 105 -5 109 23 165 16 31 53 95 82 142 62 100 180 300 180 305 0 2 27 61 61 132 101 211 146 315 163 372 22 74 20 181 -5 277 -26 101 -100 289 -150 380 -21 39 -39 81 -39 93 0 12 -11 43 -24 69 -38 75 -126 291 -153 372 -13 41 -42 107 -63 145 -20 39 -43 88 -50 110 -20 61 -87 191 -148 285 -31 47 -72 129 -93 182 -43 113 -56 134 -163 251 -91 100 -133 128 -226 152 -36 9 -101 36 -145 60 -44 23 -131 59 -193 79 -106 34 -353 135 -397 161 -11 7 -42 20 -70 29 -27 9 -75 33 -105 54 -62 42 -66 57 -37 142 8 25 27 88 42 140 45 163 48 174 72 225 13 28 23 59 23 70 0 11 7 33 15 49 8 15 15 33 15 38 0 6 11 23 24 38 61 73 59 308 -3 485 -10 28 -26 75 -36 105 -41 123 -195 283 -350 362 -66 34 -71 36 -205 63 -63 13 -133 30 -155 38 -47 17 -170 25 -239 15z"/>
              <path d="M2681 4535 c0 -5 6 -19 14 -29 8 -11 15 -15 15 -10 0 6 -7 19 -15 30 -8 10 -14 15 -14 9z"/>
            </g>
          </svg>
        </div>

        <div class="p-about-info__profile">
          <h2 class="text-3xl p-about-info__profile-title">Info</h2>
          <div class="p-about-info__profile-wrapper">
            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Age]</span>
              <p class="text-base">{age} Years Old</p>
            </div>

            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Profile]</span>
              <p class="text-base">
                I am a 4th-year engineering student specializing in Information
                Systems. I focus on backend architecture, system design, and
                building reliable applications. I enjoy writing clean code and
                solving practical technical problems.
              </p>
            </div>

            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Education]</span>
              <p class="text-base">
                <strong
                  >Saint Jean University Institute of Cameroon – Saint Jean
                  Engineering (2023 - 2028)</strong
                ><br />
                <span style="opacity: 0.85;">Engineering degree in Computer Science and Information Systems</span><br />
                <span style="opacity: 0.7; font-size: 0.9em;">Eyang, Cameroon</span><br /><br />
                <strong>Saint Benedict Catholic Bilingual College (2016 - 2023)</strong><br />
                <span style="opacity: 0.85;">General Certificate of Education Examination Advanced Level</span><br />
                <span style="opacity: 0.7; font-size: 0.9em;">Yaounde, Cameroon</span>
              </p>
            </div>

            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Core Expertise]</span>
              <p class="text-base">
                System Architecture, Full-Stack Development, Relational & NoSQL
                Database Optimization, API Design, and Cloud Deployment
                Automation.
              </p>
            </div>

            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Current Focus]</span>
              <p class="text-base">
                Currently focusing on software security, microservices, and
                cloud deployments.
              </p>
            </div>

            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Language / Availability]</span>
              <p class="text-base">
                English (Fluent), French (Fluent)<br /><br />
                Open to local software engineering roles, remote freelance projects,
                and international technical collaborations.
              </p>
            </div>

            <div class="p-about-info__profile-item">
              <span class="text-sm p-about-info__profile-label">[Interests]</span>
              <p class="text-base">
                Open-source contribution, technical writing, algorithmic problem
                solving, and exploring emerging technologies in distributed
                systems.
              </p>
            </div>

            <div
              class="p-about-info__profile-item"
              style="grid-column: 1 / -1;"
            >
              <span class="text-sm p-about-info__profile-label">[Resume]</span>
              <div class="p-about-info__cv" style="margin-top: 8px;">
                <a
                  class="btn-download ink-anim"
                  href="https://drive.google.com/file/d/1bXJkbfWW2n1ouMoRoIfS3Webop7f8djQ/view?usp=sharing"
                  target="_blank"
                  rel="noopener noreferrer">Download Resume</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="p-about-story"
      style="margin-bottom: 120px; padding: 0 20px;"
    >
      <div
        class="l-wrapper"
        style="max-width: 900px; margin: 0 auto; padding-left: 32px; border-left: 1px solid rgba(35, 53, 128, 0.2);"
      >
        <h2
          class="text-4xl ink-anim"
          style="font-family: 'RufinaALT02-Regular'; margin-bottom: 32px;"
        >
          My Engineering Journey
        </h2>
        <div
          class="ink-anim"
          style="display: flex; flex-direction: column; gap: 24px; opacity: 0.85; line-height: 1.8;"
        >
          <p class="text-base">
            I got into software engineering because I wanted to understand how
            systems work under the hood. My technical focus has always been
            centered around building applications that are reliable and easy to
            maintain.
          </p>
          <p class="text-base">
            I spend most of my time working on the backend: designing database
            schemas, building APIs, and figuring out the best way to deploy
            them. I prefer straightforward solutions over over-engineered ones,
            and I care a lot about code quality.
          </p>
          <p class="text-base">
            Right now, I'm wrapping up my degree and looking forward to working
            on larger engineering teams where I can contribute to core
            infrastructure and continue improving my technical skills.
          </p>
        </div>
      </div>
    </section>

    <TechStack />

    <section class="p-about-approach">
      <div class="p-about-approach__bg">
        <img src="/images/about-bg-pc.wpM8tw5S.jpg" alt="" />
      </div>
      <div class="p-about-approach__wrapper l-wrapper">
        <div class="p-about-approach__head">
          <h2 class="text-6xl p-about-approach__head-title">Approach</h2>
          <p class="text-lg">Things that I value while working on projects</p>
        </div>
        <div class="p-about-approach__list">
          <div class="p-about-approach__list-item">
            <h3 class="text-3xl p-about-approach__list-title">Communication</h3>
            <p class="text-base">
              I believe good work starts with open conversation. I make it a
              point to share any concerns, questions, or uncertainties rather
              than letting them go unspoken, and I value relationships where
              both sides can express themselves freely. My goal is for the
              people I work with to feel glad they did and to want to work
              together again. I believe that's what leads to better work.
            </p>
          </div>
          <div class="p-about-approach__list-item">
            <h3 class="text-3xl p-about-approach__list-title">Precision</h3>
            <p class="text-base">
              I pay close attention to code quality and system architecture.
              This means building robust and maintainable software, as well as
              researching anything I'm unsure about to suggest the most optimal
              technical approaches. I believe that dedicating time to
              foundational engineering is what ensures the success of any
              complex project.
            </p>
          </div>
          <div class="p-about-approach__list-item">
            <h3 class="text-3xl p-about-approach__list-title">Exploration</h3>
            <p class="text-base">
              I enjoy tackling different technical challenges and requirements
              with every project. I find myself drawn to the process of
              encountering complex problems I don't know how to solve yet, and I
              think that's what makes engineering exciting. Rather than sticking
              to the familiar, I value exploring new technologies and
              methodologies with genuine curiosity.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
