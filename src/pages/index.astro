  description="Abraham Noumsi — Freelance developer and designer based in Japan, focused on clean, modern, and minimal design with attention to typography, layout, and animation."
  pathname="/"
  showHeaderFooter={false}
>
<style
    slot="head"
    set:html={`.p-top-body{width:100%;min-height:100svh}.p-top-body__wrapper{width:100%;height:100%;min-height:100svh;display:flex;flex-direction:column;padding-top:clamp(32px,4vw,64px);padding-bottom:clamp(40px,31.549px + 2.254vw,64px)}.p-top-body__main{position:relative;flex:1;display:flex;flex-direction:column;row-gap:64px}.p-top-body__head{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto}@media(min-width:1024px){.p-top-body__head{grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(3,auto);position:relative}}.p-top-body__bottom{margin-top:auto;display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,auto);row-gap:40px}@media(min-width:1024px){.p-top-body__bottom{grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(1,auto)}}.p-top-body__title{width:fit-content;grid-column:1/13;grid-row:1/2}.p-top-body__textloop{margin-bottom:64px}@media(min-width:1024px){.p-top-body__textloop{margin-bottom:96px}}.p-top-body__titleja{display:none}@media(min-width:1024px){.p-top-body__titleja{display:block;position:absolute;right:0;bottom:0;z-index:-1}}.p-top-body__subtitle{grid-column:1/13;grid-row:2/3;margin-bottom:40px}.p-top-body__desc{grid-column:1/4;grid-row:3/4;display:flex}.p-top-body__version{display:flex;flex-direction:column;grid-column:1/3;grid-row:1/2}.p-top-body__time{display:flex;flex-direction:column;grid-column:3/5;grid-row:1/2}@media(min-width:1024px){.p-top-body__time{grid-column:4/6}}.p-top-body__time .blink{animation:blink 1s infinite}@keyframes blink{0%{opacity:1}50%{opacity:0}to{opacity:1}}.p-top-body__time .localtime{display:flex}.p-top-body__time .localtime span{flex-shrink:0}.p-top-body__menu{grid-column:1/3;grid-row:2/3}@media(min-width:1024px){.p-top-body__menu{grid-column:7/10;grid-row:1/2}}.p-top-body__menu-label{margin-bottom:8px}@media(min-width:1024px){.p-top-body__menu-label{margin-bottom:16px}}.p-top-body__menu-list{display:grid;grid-template-rows:repeat(2,auto);grid-auto-flow:column;row-gap:12px;column-gap:24px}.p-top-body__menu-item{display:flex;gap:24px}.p-top-body__menu-num{font-variant-numeric:tabular-nums}.p-top-body__cv{grid-column:3/5;grid-row:2/3;display:flex;align-items:center;}@media(min-width:1024px){.p-top-body__cv{grid-column:11/13;grid-row:1/2;justify-content:flex-end;}}
`}
