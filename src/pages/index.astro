---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="ABRAHAM NOUMSI | Portfolio-V2"
  description="Abraham Noumsi — Freelance developer and designer based in Japan, focused on clean, modern, and minimal design with attention to typography, layout, and animation."
  pathname="/"
  showHeaderFooter={false}
>
  <style
    slot="head"
    set:html={`.p-top-body{width:100%;height:100svh}.p-top-body__wrapper{width:100%;height:100%;display:flex;flex-direction:column;padding-top:clamp(40px,31.549px + 2.254vw,64px);padding-bottom:clamp(40px,31.549px + 2.254vw,64px)}.p-top-body__main{position:relative;flex:1;display:flex;flex-direction:column}.p-top-body__head{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto}@media(min-width:1024px){.p-top-body__head{grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(3,auto);position:relative}}.p-top-body__bottom{margin-top:auto;display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,auto);row-gap:40px}@media(min-width:1024px){.p-top-body__bottom{grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(1,auto)}}.p-top-body__title{width:fit-content;grid-column:1/13;grid-row:1/2}.p-top-body__textloop{margin-bottom:48px}@media(min-width:1024px){.p-top-body__textloop{margin-bottom:80px}}.p-top-body__titleja{display:none}@media(min-width:1024px){.p-top-body__titleja{display:block;position:absolute;right:0;bottom:0;z-index:-1}}.p-top-body__subtitle{grid-column:1/13;grid-row:2/3;margin-bottom:40px}.p-top-body__desc{grid-column:1/4;grid-row:3/4;display:flex}.p-top-body__version{display:flex;flex-direction:column;grid-column:1/3;grid-row:1/2}.p-top-body__time{display:flex;flex-direction:column;grid-column:3/5;grid-row:1/2}@media(min-width:1024px){.p-top-body__time{grid-column:4/6}}.p-top-body__time .blink{animation:blink 1s infinite}@keyframes blink{0%{opacity:1}50%{opacity:0}to{opacity:1}}.p-top-body__time .localtime{display:flex}.p-top-body__time .localtime span{flex-shrink:0}.p-top-body__menu{grid-column:1/3;grid-row:2/3}@media(min-width:1024px){.p-top-body__menu{grid-column:8/10;grid-row:1/2}}.p-top-body__menu-label{margin-bottom:8px}@media(min-width:1024px){.p-top-body__menu-label{margin-bottom:16px}}.p-top-body__menu-list{display:flex;flex-direction:column;gap:2px}.p-top-body__menu-item{display:flex;gap:40px}.p-top-body__menu-num{font-variant-numeric:tabular-nums}.p-top-body__next{grid-column:3/5;grid-row:2/3;display:flex;align-items:center;gap:16px}@media(min-width:1024px){.p-top-body__next{grid-column:11/13;grid-row:1/2;gap:32px}}.p-top-body__next-circle{width:40px;height:40px;border-radius:50%;border:solid 1px #e56a44;position:relative}@media(min-width:1024px){.p-top-body__next-circle{width:50px;height:50px}}.p-top-body__next-dot{display:block;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(1);width:4px;height:4px;border-radius:50%;background-color:#e56a44}@media(min-width:1024px){.p-top-body__next-dot{width:6px;height:6px}}.p-top-body__social{position:absolute;top:20%;right:0;display:flex;flex-direction:column;gap:16px}.p-top-body__social-item{writing-mode:vertical-lr}
`}
